# Публичные переменные сборки. Локально: скопируйте в .env.development.local — не в .env.local!
# .env.local читает и продакшн-сборка, и `npm run deploy` с этой машины запёк бы в прод тестовую кассу и localhost.
# На Cloudflare эти переменные задаются в настройках сборки (Build variables).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@festready.example
# Флаги (lib/flags.ts). Не заданы: в разработке включены, в продакшн-сборке выключены.
# Оплата: mock — тестовая касса, rollypay — настоящая, off — лист ожидания.
NEXT_PUBLIC_PAYMENTS_MODE=mock
# Прогноз и экспорт набора: on | off
NEXT_PUBLIC_FORECAST=on
NEXT_PUBLIC_KIT_EXPORT=on
# Cloudflare Web Analytics: по умолчанию — токен сайта fest-ready.fest-ready.workers.dev из lib/site.ts.
# Счётчик грузится только на адресе NEXT_PUBLIC_SITE_URL. Для своего домена — новый токен сюда.
# NEXT_PUBLIC_CF_BEACON_TOKEN=
